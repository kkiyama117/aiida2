Bootstrap: docker
# Pinned by digest, not by tag: `latest` moves with every aiida-core release,
# and even a version tag can be repushed, while the %post patches below
# rewrite specific lines of the image's init scripts.  To bump, resolve the
# new tag to a digest first (see docs/warnings.md) and re-check every patch.
# aiidateam/aiida-core-with-services:aiida-2.9.0 as of 2026-08-24
From: aiidateam/aiida-core-with-services@sha256:37c129aaba7e9347b0982746e8477fd8daf1006e8b865c74c5b5dce2057a1ced

%labels
    Description AiiDA 2.9.0 with PostgreSQL and RabbitMQ services
    Documentation https://aiida.readthedocs.io/projects/aiida-core/en/latest/installation/docker.html

%files
    # Local scheduler plugins.  They are baked into the image rather than
    # installed at runtime: /home/aiida/.local belongs to the image and is
    # read-only, so a runtime `pip install --user` would land in the
    # --writable-tmpfs overlay and vanish with the session.
    aiida_plugins/aiida-slurm-rsc /opt/aiida_plugins/aiida-slurm-rsc

%post
    # A `sed` that matches nothing still exits 0, which would ship a silently
    # unpatched image -- the failure would only show up much later as a port
    # clash or a hang.  Assert the result of every patch instead.
    assert() {
        grep -qF -e "$2" -- "$1" || {
            echo "PATCH FAILED: expected '$2' in $1" >&2
            exit 1
        }
    }

    # ------------------------------------------------------------------ #
    # PostgreSQL: run on ${PGPORT} instead of 5432                        #
    # ------------------------------------------------------------------ #
    # Apptainer shares the host network namespace, so the container's
    # PostgreSQL would clash with a host instance on the default port.
    # Every consumer is switched to ${PGPORT} (see %environment); the
    # `:-5433` fallbacks keep the scripts correct even if the variable does
    # not make it into the s6 container environment.
    sed -i 's|^   echo "unix_socket_directories = .*$|&\n   echo "port = ${PGPORT:-5433}" >> /home/${SYSTEM_USER}/.postgresql/postgresql.conf|' /etc/init/postgresql-init.sh
    assert /etc/init/postgresql-init.sh 'echo "port = ${PGPORT:-5433}"'

    sed -i 's|--postgres-password "${AIIDA_POSTGRES_PASSWORD:-password}"|& \\\n        --postgres-port "${PGPORT:-5433}"|' /etc/init/aiida-prepare.sh
    assert /etc/init/aiida-prepare.sh '--postgres-port "${PGPORT:-5433}"'

    # The stock check is `[ ! -d ~/.postgresql ]`, but run.py bind-mounts
    # that directory, so it always exists and `initdb` would never run.  Key
    # the check on the cluster marker file instead.
    sed -i 's|^if \[ ! -d /home/${SYSTEM_USER}/.postgresql \]; then$|if [ ! -f /home/${SYSTEM_USER}/.postgresql/PG_VERSION ]; then|' /etc/init/postgresql-init.sh
    sed -i 's|^   mkdir /home/${SYSTEM_USER}/.postgresql$|   mkdir -p /home/${SYSTEM_USER}/.postgresql|' /etc/init/postgresql-init.sh
    assert /etc/init/postgresql-init.sh 'if [ ! -f /home/${SYSTEM_USER}/.postgresql/PG_VERSION ]; then'
    assert /etc/init/postgresql-init.sh 'mkdir -p /home/${SYSTEM_USER}/.postgresql'

    # The stock postgresql-prepare.sh polls bare `pg_isready`, which without
    # an explicit port targets 5432 and therefore never succeeds once the
    # server has been moved.  s6-rc then waits on this oneshot forever and
    # the container hangs before ever reaching CMD.
    #
    # Apptainer shares the host network namespace, so an unrelated server can answer
    # and if it does, ours could not bind the port and AiiDA would silently
    # be initialised against the foreign database.  `pg_ctl status` is not
    # enough either (initdb's own single-user backend writes postmaster.pid,
    # so it reports "running" while the cluster is still being created).
    #
    # Ask the server on the wire instead, over exactly the host/port that
    # aiida-prepare.sh hands to `verdi presto`, and accept it only if it is
    # serving our data directory.
    cat > /etc/init/postgresql-prepare.sh <<'EOF'
#!/bin/bash
PGDATA_DIR=/home/aiida/.postgresql
HOST="${AIIDA_POSTGRES_HOSTNAME:-localhost}"
PORT="${PGPORT:-5433}"

for _ in $(seq 1 120); do
  served=$(psql -h "${HOST}" -p "${PORT}" -d postgres -Atqc 'SHOW data_directory' 2>/dev/null)
  [ "${served}" = "${PGDATA_DIR}" ] && exit 0
  sleep 1
done

echo "the bundled PostgreSQL did not become ready on ${HOST}:${PORT} after 120s" >&2
if [ -n "${served}" ]; then
  echo "another server answered there, serving ${served}; refusing to use it" >&2
elif [ -f "${PGDATA_DIR}/logfile" ]; then
  echo "last lines of ${PGDATA_DIR}/logfile:" >&2
  tail -n 20 "${PGDATA_DIR}/logfile" >&2
fi
exit 1
EOF
    chmod +x /etc/init/postgresql-prepare.sh

    # ------------------------------------------------------------------ #
    # RabbitMQ                                                            #
    # ------------------------------------------------------------------ #
    # rabbitmq-server runs the Erlang VM with `-B i`, i.e. SIGINT is
    # ignored, so the stock down-signal never stops the broker: the beam
    # process survives the container and keeps holding port 25672.  SIGTERM
    # is handled by OTP's signal server, and timeout-kill is the backstop.
    echo SIGTERM > /etc/s6-overlay/s6-rc.d/rabbitmq/down-signal
    echo 20000 > /etc/s6-overlay/s6-rc.d/rabbitmq/timeout-kill
    # A `down` file only means "start this service down" and is not a stop
    # hook for a longrun -- make sure no earlier attempt left one behind.
    rm -f /etc/s6-overlay/s6-rc.d/rabbitmq/down

    # The readiness probe is invoked 500 ms after launch, long before the
    # node exists, and rabbitmq-diagnostics then blocks for its default 60 s
    # timeout.  Bounding each probe at 5 s lets the poll loop actually poll.
    cat > /etc/s6-overlay/s6-rc.d/rabbitmq/data/check <<'EOF'
#!/bin/bash
rabbitmq-diagnostics -q -t 5 ping || exit 1
rabbitmq-diagnostics -q -t 5 check_running || exit 1
exit 0
EOF
    chmod +x /etc/s6-overlay/s6-rc.d/rabbitmq/data/check

    # ------------------------------------------------------------------ #
    # Home directory permissions                                          #
    # ------------------------------------------------------------------ #
    # Apptainer ignores the image's USER and runs as the invoking host user,
    # but the image ships /home/aiida as 2770 owned by 1000:1000, so anyone
    # with a different uid/gid cannot even traverse it -- and HOME points
    # there.  It is the only path in the image that is not world-readable,
    # so one chmod is enough.  Write access is needed too: rabbitmq-init
    # creates ~/.erlang.cookie here.  The setgid bit goes away on purpose:
    # inheriting gid 1000 fails for a user whose namespace does not map it.
    # The image stays read-only at runtime; writes land in the tmpfs overlay.
    # Symbolic, not octal: GNU chmod keeps a directory's setuid/setgid bits
    # for an octal mode, and this one has both (fix-permissions sets +6000).
    chmod a+rwx,u-s,g-s /home/aiida
    [ "$(stat -c %a /home/aiida)" = "777" ] || {
        echo "PATCH FAILED: /home/aiida is $(stat -c %a /home/aiida), not 777" >&2
        exit 1
    }

    # ------------------------------------------------------------------ #
    # Local scheduler plugins                                             #
    # ------------------------------------------------------------------ #
    # aiida-core is `pip --user` installed into /home/aiida/.local, so the
    # plugins have to go to the same user site or `verdi` will not see them.
    # HOME is set explicitly because %post runs as root: it makes pip pick
    # exactly the site directory that the runtime HOME resolves to.
    # --no-deps: aiida-core is already present and must not be resolved
    # again; --no-build-isolation: setuptools and wheel ship with the image,
    # so the build needs no network.
    HOME=/home/aiida pip install --user --no-deps --no-build-isolation \
        --no-cache-dir /opt/aiida_plugins/aiida-slurm-rsc

    # An entry point that is not registered only shows up much later, as
    # `verdi computer setup` rejecting the scheduler name.  Check it here.
    HOME=/home/aiida python3 - <<'EOF'
from importlib.metadata import entry_points
names = sorted(e.name for e in entry_points(group="aiida.schedulers"))
assert "slurm_rsc" in names, f"PATCH FAILED: aiida.schedulers = {names}"
EOF

%environment
    export HOME=/home/aiida
    # s6-overlay resets the environment for the supervision tree by default;
    # keep it so HOME and PGPORT reach the services and the CMD.
    export S6_KEEP_ENV=1
    export S6_CMD_WAIT_FOR_SERVICES_MAXTIME=600000
    export PGPORT="${AIIDA_POSTGRES_PORT:-5433}"
    # fix-permissions chgrp's to ${SYSTEM_GID} (100 in the image).  Only the
    # invoking user's gid is mapped inside Apptainer's user namespace, so
    # anything else fails with EINVAL; use the real gid.  Evaluated when this
    # script is sourced at runtime, which is what we want.
    export SYSTEM_GID="$(id -g)"

%runscript
    # `apptainer run aiida.sif` -> services up + interactive bash
    if [ $# -eq 0 ]; then set bash; fi
    exec /init "$@"

# No %startscript: `apptainer instance start` always keeps its own process as
# PID 1, so s6-overlay-suexec aborts with "can only run as pid 1" even with
# --no-init.  This image only works as a foreground session (see run.py).

%help
    AiiDA 2.9.0 with bundled PostgreSQL and RabbitMQ.

    The image is supervised by s6-overlay, which must be PID 1 and needs a
    writable /run, and only the state directories may be bind-mounted --
    aiida-core itself lives in the image's /home/aiida/.local.  Use ./run.py,
    which wraps all of that.
